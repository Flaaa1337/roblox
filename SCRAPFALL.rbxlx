local storeButton = UI.button({
	Position = UDim2.fromOffset(12, 124), Size = UDim2.fromOffset(200, 44), Text = "⭐ STORE & UPGRADES", BackgroundColor3 = C.Gold,
	TextColor3 = Color3.fromRGB(40, 30, 0), Parent = gui,
}, function()
