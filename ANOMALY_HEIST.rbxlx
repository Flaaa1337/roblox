        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">ConfigValidator</string>
            <string name="Source"><![CDATA[--!strict
-- Startup validation (spec section 23). Returns a list of problems; the
-- server refuses to start gameplay when any are found.

local GameConfig = require(script.Parent.GameConfig)
local ZoneDefinitions = require(script.Parent.ZoneDefinitions)
local CreatureDefinitions = require(script.Parent.CreatureDefinitions)
local FeatureFlags = require(script.Parent.FeatureFlags)
local Strings = require(script.Parent.Parent.Generated.Strings)

local ConfigValidator = {}

function ConfigValidator.validate(): { string }
	local problems: { string } = {}
	local function check(ok: boolean, message: string)
		if not ok then
			table.insert(problems, message)
		end
	end

	check(GameConfig.plotCount == GameConfig.maxPlayers, "plotCount must equal maxPlayers (one base per player)")
	check(GameConfig.hub.pathWidth >= 14, "hub paths must be at least 14 studs wide")

	for id, zone in ZoneDefinitions do
		check(zone.id == id, "zone id mismatch: " .. id)
		check(Strings.source[zone.nameKey] ~= nil, "zone " .. id .. " has unknown name key " .. zone.nameKey)
		local total = 0
		for _, entry in zone.spawnTable do
			local species = CreatureDefinitions[entry.speciesId]
			check(species ~= nil, "zone " .. id .. " spawns unknown species " .. entry.speciesId)
			check(species == nil or species.implemented, "zone " .. id .. " spawns unimplemented species " .. entry.speciesId)
			check(entry.weight > 0, "zone " .. id .. " has a non-positive spawn weight")
			total += entry.weight
		end
		check(not zone.implemented or total == 100, "zone " .. id .. " spawn weights must total 100 (got " .. total .. ")")
	end

	for id, species in CreatureDefinitions do
		check(species.id == id, "species id mismatch: " .. id)
		check(Strings.source[species.nameKey] ~= nil, "species " .. id .. " has unknown name key")
		check(Strings.source[species.descriptionKey] ~= nil, "species " .. id .. " has unknown description key")
	end

	check(FeatureFlags.commerce == false, "commerce must stay disabled until its release gate")
	check(FeatureFlags.trading == false, "trading must stay disabled")
	check(Strings.source["objective.first_capture"] ~= nil, "generated strings are missing")

	return problems
end

return ConfigValidator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">CreatureDefinitions</string>
            <string name="Source"><![CDATA[--!strict
-- Species records for the first slice. speciesId never changes; display
-- names are localized. Further species are added when they are implemented.

local Types = require(script.Parent.Parent.Types)

local CreatureDefinitions: { [string]: Types.SpeciesDefinition } = {
	glitch_pigeon = {
		id = "glitch_pigeon",
		nameKey = "species.glitch_pigeon.name",
		descriptionKey = "species.glitch_pigeon.description",
		rarity = "common",
		implemented = true,
	},
	fridge_dog = {
		id = "fridge_dog",
		nameKey = "species.fridge_dog.name",
		descriptionKey = "species.fridge_dog.description",
		rarity = "uncommon",
		implemented = true,
	},
	siren_toad = {
		id = "siren_toad",
		nameKey = "species.siren_toad.name",
		descriptionKey = "species.siren_toad.description",
		rarity = "uncommon",
		implemented = true,
	},
}

return CreatureDefinitions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">FeatureFlags</string>
            <string name="Source"><![CDATA[--!strict
-- Server-authoritative feature flags. Conservative defaults: anything that
-- changes ownership or involves money starts off. The client may read these
-- to hide UI; it can never enable a server capability.

local FeatureFlags = {
	pvp = false, -- M4
	commerce = false, -- M6, requires owner approval
	trading = false, -- post-launch, separate spec
	liveEvents = false,
	capture = false, -- M2: capture/cargo/extraction loop
	mutationGeneration = false, -- M2
	-- Studio-only localization stress test: "off" | "long" | "rtl".
	-- Ignored outside Studio. See docs/LOCALIZATION.md.
	studioPseudoLocale = "off",
}

return FeatureFlags
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Versioned tunable values. Change values here, never inline in services.

local GameConfig = {
	version = "0.1.0-m1",

	maxPlayers = 8,
	plotCount = 8, -- exactly one base per player slot

	hub = {
		size = 256,
		plotRingRadius = 100,
		plotSize = 32,
		pathWidth = 14,
		spawnOffset = Vector3.new(0, 0, -40), -- spawn faces the beginner portal (+Z)
	},

	portal = {
		promptDistance = 10,
		maxUseDistance = 16, -- server-side proximity check (prompt range + latency slack)
		cooldownSeconds = 3,
		streamTimeoutSeconds = 6,
		clientTimeoutSeconds = 10,
		fallCheckDelaySeconds = 3,
		fallDistance = 40, -- below the arrival point counts as "fell into the void"
	},

	camera = {
		minZoom = 6,
		maxZoom = 40,
	},
}

return GameConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">ZoneDefinitions</string>
            <string name="Source"><![CDATA[--!strict
-- Expedition zones. Only implemented zones get a working portal; the others
-- show a dormant portal frame with a "not available yet" sign.

local Types = require(script.Parent.Parent.Types)

local ZoneDefinitions: { [string]: Types.ZoneDefinition } = {
	glitch_grove = {
		id = "glitch_grove",
		nameKey = "area.glitch_grove",
		center = Vector3.new(0, 0, 768),
		size = Vector2.new(256, 256),
		implemented = true,
		portalSide = "north",
		-- M2 slice spawn table: only implemented species (spec section 8).
		spawnTable = {
			{ speciesId = "glitch_pigeon", weight = 50 },
			{ speciesId = "fridge_dog", weight = 30 },
			{ speciesId = "siren_toad", weight = 20 },
		},
	},
	scrap_district = {
		id = "scrap_district",
		nameKey = "area.scrap_district",
		center = Vector3.new(768, 0, 0),
		size = Vector2.new(256, 256),
		implemented = false,
		portalSide = "east",
		spawnTable = {},
	},
	void_station = {
		id = "void_station",
		nameKey = "area.void_station",
		center = Vector3.new(-768, 0, 0),
		size = Vector2.new(256, 256),
		implemented = false,
		portalSide = "west",
		spawnTable = {},
	},
}

return ZoneDefinitions
]]></string>
          </Properties>
        </Item>
      </Item>
